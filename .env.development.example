# Generate .env.development with: python scripts/init_dev_env.py
APP_ENV=development
POSTGRES_USER=twstock_dev
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
POSTGRES_DB=twstock_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=
FRONTEND_CONTEXT=../tw-stock-frontend
DEV_WEB_PORT=3007
DEV_DB_PORT=5433
# Enable only if Docker Desktop/WSL does not detect source changes.
DEV_USE_POLLING=false
