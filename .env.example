# Backend-only configuration. Do not commit backend/.env.
# Replace with credentials for a dedicated development PostgreSQL database.
APP_ENV=development
POSTGRES_USER=twstock
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
POSTGRES_DB=twstock
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Exact browser origins. Production requires explicit HTTPS origins and uses
# __Host-session (Secure/HttpOnly); development uses session on localhost HTTP.
# JSON array, no trailing slash. Cross-origin credential CORS is not enabled.
AUTH_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# Argon2 jobs per backend process; each recommended hash uses about 64 MiB.
PASSWORD_MAX_CONCURRENCY=2

# Optional Docker Compose gateway settings (used by Compose, not FastAPI).
# The frontend checkout must contain its Nginx Dockerfile.
FRONTEND_CONTEXT=../tw-stock-frontend
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
