# Backend-only configuration. Do not commit backend/.env.
# Replace with credentials for a dedicated development PostgreSQL database.
APP_ENV=development
POSTGRES_USER=twstock
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
POSTGRES_DB=twstock
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Optional Docker Compose gateway settings (used by Compose, not FastAPI).
# The frontend checkout must contain its Nginx Dockerfile.
FRONTEND_CONTEXT=../tw-stock-frontend
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
