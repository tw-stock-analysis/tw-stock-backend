# Copy to .env.production on the future deployment host; never commit secrets.
# Copy exact references from the successful GHCR publisher summaries/artifacts.
BACKEND_IMAGE=ghcr.io/tw-stock-analysis/tw-stock-backend@sha256:REPLACE_WITH_VERIFIED_DIGEST
FRONTEND_IMAGE=ghcr.io/tw-stock-analysis/tw-stock-frontend@sha256:REPLACE_WITH_VERIFIED_DIGEST
SITE_HOST=stocks.example.com
AUTH_ALLOWED_ORIGINS=["https://stocks.example.com"]
# Absolute directory containing fullchain.pem and privkey.pem for SITE_HOST.
TLS_CERT_DIR=/etc/tw-stock/tls
POSTGRES_USER=twstock_prod
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
POSTGRES_DB=twstock_prod
WEB_BIND_ADDRESS=0.0.0.0
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
PASSWORD_MAX_CONCURRENCY=2

# Optional FinMind member token; backend only. Empty uses the anonymous Free quota.
FINMIND_API_TOKEN=
